<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Version>0.6.0-pla.15</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>FreedomArrow.Runtime</AssemblyName>

    <ML>$(GameDir)/MelonLoader/net6</ML>
    <IL2>$(GameDir)/MelonLoader/Il2CppAssemblies</IL2>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MelonLoader"><HintPath>$(ML)/MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(ML)/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(ML)/Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Common"><HintPath>$(ML)/Il2CppInterop.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(IL2)/Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppSystem"><HintPath>$(IL2)/Il2CppSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppBrokenArrow"><HintPath>$(IL2)/Il2CppBrokenArrow.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppDefaultEcs"><HintPath>$(IL2)/Il2CppDefaultEcs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppNetworkCommon"><HintPath>$(IL2)/Il2CppNetworkCommon.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppGalaxyCoreCommon"><HintPath>$(IL2)/Il2CppGalaxyCoreCommon.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(IL2)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(IL2)/UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(IL2)/UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(IL2)/Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(IL2)/UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(IL2)/UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
